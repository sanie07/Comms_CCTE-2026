Core/Src/usart.c.obj:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/ComsBoard_RadioLib.dir/build.make CMakeFiles/ComsBoard_RadioLib.dir/Core/Src/usart.c.obj
.PHONY : Core/Src/usart.c.obj

Core/Src/usart.i: Core/Src/usart.c.i
.PHONY : Core/Src/usart.i

# target to preprocess a source file
Core/Src/usart.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/ComsBoard_RadioLib.dir/build.make CMakeFiles/ComsBoard_RadioLib.dir/Core/Src/usart.c.i
.PHONY : Core/Src/usart.c.i

Core/Src/usart.s: Core/Src/usart.c.s
.PHONY : Core/Src/usart.s

# target to generate assembly for a file
Core/Src/usart.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/ComsBoard_RadioLib.dir/build.make CMakeFiles/ComsBoard_RadioLib.dir/Core/Src/usart.c.s
.PHONY : Core/Src/usart.c.s

